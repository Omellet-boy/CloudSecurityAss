USE [master];
GO

-- This changes the login password at the server level
ALTER LOGIN [AlumniAppUser] WITH PASSWORD = 'YourNewActualPassword123!';
GO

-- Ensure the login is enabled
ALTER LOGIN [AlumniAppUser] ENABLE;
GO

USE [AlumniDB];
GO

-- Ensure the user is mapped to the login in this specific DB
IF NOT EXISTS (SELECT * FROM sys.database_principals WHERE name = N'AlumniAppUser')
BEGIN
    CREATE USER [AlumniAppUser] FOR LOGIN [AlumniAppUser];
END
GO

-- Ensure they have data access
ALTER ROLE [db_datareader] ADD MEMBER [AlumniAppUser];
ALTER ROLE [db_datawriter] ADD MEMBER [AlumniAppUser];
GO
