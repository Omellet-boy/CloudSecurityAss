USE [AlumniDB]
GO
CREATE SCHEMA Security;
GO

CREATE FUNCTION Security.fn_securitypredicate(@UserId AS bigint)
    RETURNS TABLE
WITH SCHEMABINDING
AS
    RETURN SELECT 1 AS fn_securitypredicate_result
    WHERE 
        -- If the app tells SQL the role is 'admin', allow everything
        CAST(SESSION_CONTEXT(N'user_role') AS varchar(50)) = 'admin' 
        -- Otherwise, the UserId in the table must match the UserId the app sent
        OR @UserId = CAST(SESSION_CONTEXT(N'user_id') AS bigint);
GO

------------------------------------------------------------------------------------------------

-- Lock the Alumni table so users only see their own profile
CREATE SECURITY POLICY Security.AlumniFilter
ADD FILTER PREDICATE Security.fn_securitypredicate(user_id) ON dbo.Alumni,
ADD BLOCK PREDICATE Security.fn_securitypredicate(user_id) ON dbo.Alumni
WITH (STATE = ON);
GO

-- Lock the Users table so users only see their own account info
CREATE SECURITY POLICY Security.UserFilter
ADD FILTER PREDICATE Security.fn_securitypredicate(user_id) ON dbo.Users,
ADD BLOCK PREDICATE Security.fn_securitypredicate(user_id) ON dbo.Users
WITH (STATE = ON);
GO

