USE [AlumniDB]
GO
CREATE SCHEMA Security;
GO

CREATE FUNCTION Security.fn_securitypredicate(@UserId AS bigint)
    RETURNS TABLE
WITH SCHEMABINDING
AS
    RETURN SELECT 1 AS fn_securitypredicate_result
    WHERE 
        -- If the app tells SQL the role is 'admin', allow everything
        CAST(SESSION_CONTEXT(N'user_role') AS varchar(50)) = 'admin' 
        -- Otherwise, the UserId in the table must match the UserId the app sent
        OR @UserId = CAST(SESSION_CONTEXT(N'user_id') AS bigint);
GO
